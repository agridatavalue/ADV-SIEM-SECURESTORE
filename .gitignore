# Credentials — never commit these.
#
# The previous version of this project kept the MinIO root password in .env
# files that were committed. Nothing matching these patterns belongs in the
# repository; supply credentials via a Kubernetes Secret instead (see README).
.env
.env.*
*.env
values.local.yaml
values-local.yaml
secrets.yaml
secrets-*.yaml
*.secret.yaml
*.pem
*.key
kubeconfig
.kube/

# Helm
*.tgz
charts/*/charts/
charts/*/Chart.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
